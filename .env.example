# Payment Switch Application Environment Configuration

# Database Configuration
MONGO_ROOT_PASSWORD=paymentswitch123
MONGODB_URI=mongodb://admin:paymentswitch123@localhost:27017/payment_switch?authSource=admin
REDIS_URI=redis://localhost:6379

# Service Ports
TRANSACTION_PROCESSOR_PORT=3001
ROUTING_ENGINE_PORT=3002
PSP_GATEWAY_PORT=3003
MANAGEMENT_API_PORT=3004
MONITORING_PORT=3005
FRONTEND_PORT=8080
NODE_RED_PORT=1880

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-32-character-encryption-key-here
API_RATE_LIMIT=1000

# PSP Configuration (Sandbox/Test Keys)
VISA_API_KEY=your-visa-api-key
VISA_API_SECRET=your-visa-api-secret
VISA_BASE_URL=https://sandbox.api.visa.com

MASTERCARD_API_KEY=your-mastercard-api-key
MASTERCARD_API_SECRET=your-mastercard-api-secret
MASTERCARD_BASE_URL=https://sandbox.api.mastercard.com

# Compliance and Security
PCI_COMPLIANCE_MODE=true
GDPR_COMPLIANCE_MODE=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
TRANSACTION_LOG_LEVEL=info

# Monitoring and Alerting
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
ALERT_EMAIL_FROM=alerts@paymentswitch.com
ALERT_EMAIL_TO=admin@paymentswitch.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# High Availability Configuration
ENABLE_CLUSTERING=false
CLUSTER_NODES=3
HEALTH_CHECK_INTERVAL=30000
FAILOVER_TIMEOUT=5000

# Development/Production Mode
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# SSL/TLS Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/payment-switch.crt
SSL_KEY_PATH=/etc/ssl/private/payment-switch.key

# Message Format Configuration
ENABLE_ISO8583=true
ENABLE_ISO20022=true
DEFAULT_MESSAGE_FORMAT=ISO8583

# Geographic Configuration
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,CAD,AUD

# Performance Configuration
MAX_CONCURRENT_TRANSACTIONS=10000
TRANSACTION_TIMEOUT=30000
CONNECTION_POOL_SIZE=10
CACHE_TTL=300

