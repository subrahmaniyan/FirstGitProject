{
  "name": "payment-switch-frontend",
  "version": "1.0.0",
  "description": "Web-based management interface for the payment switch application",
  "main": "index.html",
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "dev": "live-server --port=8080 --no-browser",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/css/main.css -o dist/css/main.min.css --use autoprefixer cssnano",
    "build:js": "webpack --mode=production",
    "watch:css": "postcss src/css/main.css -o dist/css/main.css --use autoprefixer --watch",
    "watch:js": "webpack --mode=development --watch",
    "test": "jest",
    "lint": "eslint src/js/**/*.js",
    "format": "prettier --write src/**/*.{js,css,html}"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "socket.io-client": "^4.7.4",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "bootstrap": "^5.3.2",
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "live-server": "^1.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

